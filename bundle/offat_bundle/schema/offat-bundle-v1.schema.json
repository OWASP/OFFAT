{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dmdhrumilmistry/offat-ai/schema/offat-bundle-v1.json",
  "title": "OFFAT Bundle",
  "description": "Canonical interchange document for the OFFAT-AI platform. schema_version and meta are required; every other section is optional so partial bundles from early pipeline stages are valid.",
  "type": "object",
  "required": ["schema_version", "meta"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "meta": {
      "type": "object",
      "required": ["run_id", "generated_at"],
      "additionalProperties": true,
      "properties": {
        "tool": { "type": "string" },
        "version": { "type": "string" },
        "run_id": { "type": "string" },
        "generated_at": { "type": "string" },
        "target": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "source_path": { "type": "string" },
            "base_url": { "type": "string" },
            "spec": { "type": "string" }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string" },
              "tool": { "type": "string" },
              "version": { "type": "string" },
              "at": { "type": "string" }
            }
          }
        }
      }
    },
    "asm": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "endpoints": { "type": "array", "items": { "$ref": "#/$defs/endpoint" } }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sinks": { "type": "array", "items": { "$ref": "#/$defs/sink" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      }
    },
    "prg": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/prgNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/prgEdge" } }
      }
    },
    "threat_model": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "assets": { "type": "array", "items": { "type": "object" } },
        "trust_boundaries": { "type": "array", "items": { "type": "object" } },
        "dataflows": { "type": "array", "items": { "type": "object" } },
        "threats": { "type": "array", "items": { "$ref": "#/$defs/threat" } },
        "dfd_mermaid": { "type": "string" }
      }
    },
    "test_plan": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cases": { "type": "array", "items": { "$ref": "#/$defs/testCase" } }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "executions": { "type": "array", "items": { "$ref": "#/$defs/execution" } }
      }
    },
    "findings": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "param": {
      "type": "object",
      "required": ["name", "location"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string", "enum": ["path", "query", "header", "cookie", "body", "form"] },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "example": {}
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["id", "method", "path"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "method": { "type": "string" },
        "path": { "type": "string" },
        "protocol": { "type": "string" },
        "operation_id": { "type": "string" },
        "handler": { "type": "string" },
        "auth": { "type": "object" },
        "source": { "type": "object" },
        "params": { "type": "array", "items": { "$ref": "#/$defs/param" } },
        "responses": { "type": "array", "items": { "type": "object" } }
      }
    },
    "sink": {
      "type": "object",
      "required": ["id", "class"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "class": { "type": "string" },
        "symbol": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer" },
        "cwe": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "symbol": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer" }
      }
    },
    "prgNode": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["producer", "consumer"] },
        "endpoint": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string" }
      }
    },
    "prgEdge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": true,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "basis": { "type": "string" },
        "resource": { "type": "string" }
      }
    },
    "threat": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "stride": { "type": "string" },
        "endpoint": { "type": "string" },
        "owasp_api": { "type": "string" },
        "cwe": { "type": "string" },
        "likelihood": { "type": "string" },
        "impact": { "type": "string" },
        "risk": { "type": "string" },
        "mitigation": { "type": "string" }
      }
    },
    "testCase": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "endpoint": { "type": "string" },
        "param": { "type": "string" },
        "location": { "type": "string" },
        "class": { "type": "string" },
        "technique": { "type": "string" },
        "protocol": { "type": "string" },
        "payload": { "type": "string" },
        "origin": { "type": "string", "enum": ["rule", "ai"] },
        "rationale": { "type": "string" },
        "chain": { "type": "array", "items": { "type": "string" } },
        "expected_signal": { "type": "string" }
      }
    },
    "execution": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "case_id": { "type": "string" },
        "protocol": { "type": "string" },
        "request": { "type": "object" },
        "response": { "type": "object" },
        "baseline": { "type": "object" },
        "latency_ms": { "type": "number" },
        "at": { "type": "string" }
      }
    }
  }
}
