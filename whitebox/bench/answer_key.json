{
  "_comment": "Ground-truth labels for the taint-engine benchmark. `expect` lists the (file, class) flows the engine should prove; `silent` lists routes that MUST NOT produce a flow (the safe twins). Derived from whitebox/tests/fixtures/taint_app and asserted by tests/test_cpg.py. Line numbers are intentionally omitted so small edits to the fixture do not churn the key; matching is by (file, class).",
  "targets": [
    {
      "name": "taint_app",
      "path": "tests/fixtures/taint_app",
      "needs_tree_sitter": true,
      "expect": [
        {"file": "pkg/db.py", "class": "sqli", "route": "GET /search"},
        {"file": "pkg/shell.py", "class": "command_injection", "route": "POST /ping"},
        {"file": "flask_app.py", "class": "path_traversal", "route": "GET /files/<name>"},
        {"file": "flask_app.py", "class": "ssrf", "route": "GET /fetch"},
        {"file": "flask_app.py", "class": "open_redirect", "route": "GET /next"},
        {"file": "flask_app.py", "class": "ssti", "route": "GET /hello"},
        {"file": "flask_app.py", "class": "deserialization", "route": "POST /import"},
        {"file": "flask_app.py", "class": "mass_assignment", "route": "POST /users"},
        {"file": "flask_app.py", "class": "bola", "route": "GET /orders/<order_id>"},
        {"file": "fastapi_app.py", "class": "sqli", "route": "GET /lookup"},
        {"file": "fastapi_app.py", "class": "deserialization", "route": "POST /config"},
        {"file": "express_app.js", "class": "command_injection", "route": "GET /ping", "needs_tree_sitter": true},
        {"file": "express_app.js", "class": "path_traversal", "route": "GET /file", "needs_tree_sitter": true},
        {"file": "express_app.js", "class": "ssrf", "route": "GET /proxy", "needs_tree_sitter": true},
        {"file": "express_app.js", "class": "xss", "route": "GET /greet", "needs_tree_sitter": true},
        {"file": "jsdb.js", "class": "sqli", "route": "GET /user", "needs_tree_sitter": true}
      ],
      "silent": [
        "GET /search-safe", "POST /ping-quoted", "GET /files-safe/<name>", "GET /count/<int:n>",
        "GET /calc", "GET /strip", "GET /my-orders/<order_id>", "GET /receipts/<order_id>",
        "GET /items/{item_id}", "POST /config-safe", "POST /convert",
        "GET /file-safe", "GET /greet-num"
      ]
    }
  ]
}
